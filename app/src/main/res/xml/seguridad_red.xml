<?xml version="1.0" encoding="utf-8"?>
<!-- INOCAR (tablas de marea) usa la raíz «SSL.com TLS RSA Root CA 2022», que Android 13 o anterior no trae.
     Se suma solo para ese dominio, junto a las del sistema. Huella SHA-256 verificada contra la lista de Mozilla:
     8F:AF:7D:2E:2C:B4:70:9B:B8:E0:B3:36:66:BF:75:A5:DD:45:B5:DE:48:0F:8E:A8:D4:BF:E6:BE:BC:17:F2:ED (vence en 2046). -->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="true">inocar.mil.ec</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/sslcom_tls_rsa_root_2022" />
        </trust-anchors>
    </domain-config>
</network-security-config>
